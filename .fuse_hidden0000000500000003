/* ===================== Desbloqueio por descriptografia (AES-GCM) =====
   O capítulo vive cifrado em LOCKED_ENC. Sem o código correto, não há texto
   em claro na página — o Inspecionar mostra só bytes embaralhados. */
const LOCKED_ENC = {"salt":"U1uGsFi01cY2dRx/DjW/GA==","iv":"i/Zn/c1ABqw1ejw0","ct":"","iter":300000};
const _b=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function decryptLocked(pass){
  const salt=_b(LOCKED_ENC.salt), iv=_b(LOCKED_ENC.iv), data=_b(LOCKED_ENC.ct);
  const km=await crypto.subtle.importKey("raw",new TextEncoder().encode(pass),"PBKDF2",false,["deriveKey"]);
  const key=await crypto.subtle.deriveKey(
    {name:"PBKDF2",salt,iterations:LOCKED_ENC.iter,hash:"SHA-256"},
    km,{name:"AES-GCM",length:256},false,["decrypt"]);
  const pt=await crypto.subtle.decrypt({name:"AES-GCM",iv},key,data);
  return new TextDecoder().decode(pt);
}
document.getElementById("unlockBtn").onclick=async()=>{
  const pass=document.getElementById("codeInput").value.trim().toUpperCase().replace(/[‐-―−⁃﹘﹣－]/g,"-").replace(/\s+/g,"");
  const err=document.getElementById("unlockErr"); err.textContent="";
  if(!pass){ document.getElementById("codeInput").focus(); return; }
  try{
    const inner=await decryptLocked(pass);
    document.getElementById("locked").innerHTML=inner;
    document.body.classList.add("unlocked");
    window.scrollTo({top:0,behavior:"smooth"});
  }catch(e){ err.textContent="⚠ Código inválido. Confira e tente de novo."; }
};
document.getElementById("codeInput") && document.getElementById("codeInput")
  .addEventListener("keydown",e=>{ if(e.key==="Enter") document.getElementById("unlockBtn").click(); });
