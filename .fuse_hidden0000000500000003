<script>
/* =====================================================================
   ⚙️  CONFIG — PIX (provisório: preencha pixKey)
   pixKey : CPF (só números), e-mail, telefone (+5511...) ou chave aleatória.
   name   : recebedor, SEM acento, MÁX 25.   city: SEM acento, MÁX 15.
   ===================================================================== */
const PIX = {
  pixKey: "+5541995887803",
  name:   "ROBERTA SANTIAGO",
  city:   "SAO PAULO"
};

/* ---- Tiers (provisórios — CRUD do universo SOLPHI) -------------------- */
const TIERS = [
  { v:30,  crud:"READ",   color:"#4de3ff", tag:"O Vidente",
    perks:[ "Leitura liberada de todos os capítulos",
            "Seu nome no mural dos Videntes",
            "Pack de wallpapers do universo" ] },
  { v:60,  crud:"CREATE", color:"#b98cff", tag:"O Arquiteto",
    perks:[ "Tudo do Vidente",
            "Fórum de apoiadores pra ajudar a moldar o livro",
            "Artbook digital de personagens" ] },
  { v:120, crud:"DELETE", color:"#ff5d6c", tag:"O Anulador",
    perks:[ "Tudo do Arquiteto",
            "Capítulos liberados com antecedência",
            "Lista de espera do livro físico" ] },
  { v:250, crud:"UPDATE", color:"#7c9cff", tag:"O Hacker da Realidade", featured:true,
    perks:[ "Tudo do Anulador",
            "E-book completo (na conclusão do livro)",
            "Capa dura + agradecimento nominal + contato direto" ] },
];

/* ===================== Geração do BR Code (Pix) ======================= */
function noAccent(s){return (s||"").normalize("NFD").replace(/[̀-ͯ]/g,"");}
function san(s,max){return noAccent(s).toUpperCase().replace(/[^A-Z0-9 ]/g,"").trim().slice(0,max);}
function emv(id,val){return id + String(val.length).padStart(2,"0") + val;}
function crc16(str){
  let crc=0xFFFF;
  for(let i=0;i<str.length;i++){
    crc^=str.charCodeAt(i)<<8;
    for(let j=0;j<8;j++){ crc=(crc&0x8000)?((crc<<1)^0x1021):(crc<<1); crc&=0xFFFF; }
  }
  return crc.toString(16).toUpperCase().padStart(4,"0");
}
function pixCode(amount){
  const key=(PIX.pixKey||"").trim();
  if(!key || key==="SUA_CHAVE_PIX_AQUI") return null;
  const mai=emv("00","br.gov.bcb.pix")+emv("01",key);
  let p="";
  p+=emv("00","01");
  p+=emv("26",mai);
  p+=emv("52","0000");
  p+=emv("53","986");
  if(amount>0) p+=emv("54",Number(amount).toFixed(2));
  p+=emv("58","BR");
  p+=emv("59",san(PIX.name,25)||"RECEBEDOR");
  p+=emv("60",san(PIX.city,15)||"CIDADE");
  p+=emv("62",emv("05","PROJETOSOLPHI"));
  p+="6304";
  return p+crc16(p);
}

/* ===================== UI ============================================= */
const brl=n=>"R$"+Number(n).toFixed(2).replace(".",",");
const modal=document.getElementById("modal");
const qrbox=document.getElementById("qrbox");
const copybox=document.getElementById("copybox");

function openPix(amount,tierLabel){
  const code=pixCode(amount);
  document.getElementById("mTier").textContent=tierLabel||"APOIO LIVRE";
  document.getElementById("mVal").textContent=brl(amount);
  qrbox.innerHTML=""; copybox.textContent="";
  if(!code){
    qrbox.innerHTML='<div class="err">Configure a chave Pix (campo pixKey) para gerar o codigo.</div>';
    document.getElementById("copybtn").style.display="none";
    modal.classList.add("on"); return;
  }
  copybox.textContent=code;
  document.getElementById("copybtn").style.display="";
  modal.classList.add("on");
  try{
    if(typeof QRCode!=="undefined"){
      new QRCode(qrbox,{text:code,width:180,height:180,correctLevel:QRCode.CorrectLevel.M});
    }else{
      qrbox.innerHTML='<div style="color:#04161c;font:12px/1.4 sans-serif;padding:10px;text-align:center">QR indisponivel offline.<br>Use o codigo copia-e-cola abaixo.</div>';
    }
  }catch(e){
    qrbox.innerHTML='<div style="color:#04161c;font:12px/1.4 sans-serif;padding:10px;text-align:center">QR indisponivel.<br>Use o codigo copia-e-cola abaixo.</div>';
  }
}
document.getElementById("copybtn").onclick=function(){
  const t=copybox.textContent; if(!t)return;
  navigator.clipboard.writeText(t).then(()=>{
    this.textContent="✓ Código copiado!";
    setTimeout(()=>this.textContent="📋 Copiar código Pix",1800);
  }).catch(()=>{ const r=document.createRange();r.selectNode(copybox);
    getSelection().removeAllRanges();getSelection().addRange(r); });
};
document.getElementById("mClose").onclick=()=>modal.classList.remove("on");
modal.onclick=e=>{ if(e.target===modal) modal.classList.remove("on"); };

/* café */
document.querySelectorAll("[data-cafe]").forEach(b=>{
