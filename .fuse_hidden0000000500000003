  .tier:hover{transform:translateY(-4px);border-color:var(--tc,var(--acc))}
  .tier::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--tc,var(--acc))}
  .tier.featured{border-color:var(--tc,var(--acc))}
  .tier .crud{font-family:var(--mono);font-size:12px;letter-spacing:.2em;color:var(--tc,var(--acc));text-transform:uppercase;margin-bottom:6px}
  .tier .name{font-size:17px;font-weight:600;margin-bottom:2px;font-family:var(--disp);color:var(--text)}
  .tier .price{font-family:var(--disp);font-size:26px;font-weight:700;margin:6px 0 14px;color:var(--text)}
