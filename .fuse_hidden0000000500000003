  .tier li.prev::before{content:"+";color:var(--faint)}
  .tier .btn{width:100%;background:transparent;border:1px solid var(--tc,var(--acc));color:var(--tc,var(--acc))}
  .tier .btn:hover{background:var(--tc,var(--acc));color:#04161c}
  .badge{position:absolute;top:12px;right:12px;font-family:var(--mono);font-size:10px;letter-spacing:.14em;
    padding:3px 8px;border-radius:5px;background:rgba(185,140,255,.12);color:var(--violet);border:1px solid rgba(185,140,255,.4)}

  .note{background:var(--panel2);border:1px solid var(--line);border-left:2px solid var(--acc);
    border-radius:10px;padding:14px 16px;font-size:12.5px;color:var(--dim);margin:18px 0 6px;text-align:left}
  .note b{color:var(--text)}

  .unlockbox{margin:18px 0 0;text-align:left}
  .ulabel{display:block;font-size:13px;color:var(--dim);margin-bottom:8px}
  .ulabel b{color:var(--acc)}
  .ulrow{display:flex;gap:8px;flex-wrap:wrap}
  .ulrow input{flex:1;min-width:170px;background:var(--panel);border:1px solid var(--line2);border-radius:8px;
    padding:12px 14px;color:var(--text);font-family:var(--mono);font-size:15px;outline:none}
  .ulrow input:focus{border-color:var(--acc)}
  .unlockerr{color:var(--danger);font-family:var(--mono);font-size:12px;margin:10px 0 0;min-height:14px}
  .ulnote{color:var(--faint);font-size:11.5px;margin:10px 0 0;line-height:1.45}

  .locked{display:none}
  body.unlocked .locked{display:block;animation:fade .4s ease}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .endmark{font-family:var(--mono);color:var(--acc);letter-spacing:.2em;text-align:center;font-size:12px;margin:34px 0;opacity:.7}

  footer{text-align:center;color:var(--faint);font-size:12px;padding:30px 0 60px;font-family:var(--mono);border-top:1px solid var(--line);margin-top:20px}

  .modal{position:fixed;inset:0;z-index:60;background:rgba(4,6,9,.86);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:20px}
  .modal.on{display:flex}
  .card{background:var(--panel);border:1px solid var(--line2);border-radius:16px;width:100%;max-width:400px;padding:26px;text-align:center;position:relative;animation:pop .2s ease}
  @keyframes pop{from{transform:scale(.96);opacity:0}to{transform:scale(1);opacity:1}}
  .card .close{position:absolute;top:14px;right:16px;background:none;border:0;color:var(--dim);font-size:22px;cursor:pointer;line-height:1}
  .card .mtier{font-family:var(--mono);font-size:12px;letter-spacing:.2em;color:var(--acc);text-transform:uppercase}
  .card .mval{font-size:32px;font-weight:700;font-family:var(--disp);margin:2px 0 16px;color:var(--text)}
  .qrbox{background:#fff;border-radius:12px;padding:14px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;min-height:180px;min-width:180px}
  .qrbox img,.qrbox canvas{display:block}
  .copybox{background:var(--bg);border:1px solid var(--line2);border-radius:8px;padding:10px 12px;font-family:var(--mono);font-size:11px;color:var(--dim);word-break:break-all;text-align:left;max-height:70px;overflow:auto;margin-bottom:12px}
  .copybtn{width:100%;background:var(--acc);color:#04161c;font-weight:700;border:0;border-radius:8px;padding:13px;cursor:pointer;font-size:15px;font-family:var(--disp)}
  .copybtn:active{transform:scale(.98)}
  .mhint{font-size:12px;color:var(--dim);margin-top:12px}
  .err{color:var(--danger);font-size:13px;font-family:var(--mono);padding:20px}
  .nextchap{display:none;margin:8px 0 34px}
  body.unlocked .nextchap{display:block}
  .nextchap a,.nextchap span{display:block;text-align:center;text-decoration:none;border:1px solid var(--line2);border-radius:12px;padding:16px;color:var(--acc);font-family:var(--disp);font-weight:600;transition:.15s}
  .nextchap a:hover{border-color:var(--acc);background:var(--panel2)}
  .nextchap span{color:var(--faint);font-family:var(--mono);font-weight:400;font-size:13px}

  /* ao desbloquear: some a paywall, vira tela de leitura limpa */
  body.unlocked .prov,
  body.unlocked #paywall{display:none}
  body.unlocked .reading.preview{padding-top:8px}
  .backtop{display:none}
  body.unlocked .backtop{display:inline-flex;align-items:center;gap:7px;position:sticky;top:14px;z-index:30;
    margin:14px 0 -8px;font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--dim);text-decoration:none;background:rgba(10,13,18,.7);backdrop-filter:blur(6px);
    border:1px solid var(--line2);border-radius:999px;padding:8px 14px;transition:.15s}
  body.unlocked .backtop:hover{color:var(--acc);border-color:var(--acc)}
  .endmark{display:none}
  body.unlocked .endmark{display:block}
  .chapnav{display:none;gap:12px;margin:14px 0 40px}
  body.unlocked .chapnav{display:flex}
  .chapnav a{flex:1;text-align:center;text-decoration:none;border:1px solid var(--line2);border-radius:12px;
    padding:16px 16px;color:var(--acc);font-family:var(--disp);font-weight:600;transition:.15s;background:var(--panel)}
  .chapnav a:hover{border-color:var(--acc);background:var(--panel2);transform:translateY(-2px)}
  .chapnav a.prev{color:var(--dim)}
  .chapnav a.prev:hover{color:var(--acc)}
  .chapnav a.disabled{color:var(--faint);font-family:var(--mono);font-weight:400;font-size:13px;pointer-events:none;opacity:.7}
</style>
</head>
